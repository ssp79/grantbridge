# Copy to .env (in this folder or the folder above it) and fill in ONE key.
# Never commit the real .env.

# Course key — the app uses gpt-6-luna with this key.
PORTKEY_API_KEY=

# Optional: your own OpenAI key, used only if PORTKEY_API_KEY is empty
# (or if GRANTBRIDGE_PROVIDER=openai).
OPENAI_API_KEY=

# Optional, non-secret settings:
# GRANTBRIDGE_PROVIDER=openai
# OPENAI_MODEL=gpt-6-luna
# GRANTBRIDGE_LIVE_SEARCH=off   # hide live Grants.gov search (sample grants still work)
# GRANTBRIDGE_ADVISOR_MODE=mock # start the AI Advisor in free mock mode
# GRANTBRIDGE_DAILY_TOKEN_BUDGET=100000  # max AI tokens per account per 24 hours
# GRANTBRIDGE_SERVER_DAILY_TOKEN_BUDGET=1000000  # max AI tokens for all accounts together per 24 hours
# GRANTBRIDGE_AI_REQUESTS_PER_MINUTE=15  # max AI requests per account per minute
# GRANTBRIDGE_REASONING_EFFORT=low  # low (the measured cost saver), medium, high, or default (send none)
# GRANTBRIDGE_PRICING_FILE=data/pricing.json  # token prices used for cost estimates
# GRANTBRIDGE_SECURITY_DEMO=on  # add the malicious sample grant used to demonstrate the defenses
